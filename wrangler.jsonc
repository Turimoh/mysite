// Cloudflare's settings. The site is fully static — just files — so all
// Cloudflare needs to know is where the finished files are.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maureen-portfolio",
  "compatibility_date": "2026-09-30",
  // The addresses this site answers on. custom_domain: Cloudflare creates the
  // DNS record and the https certificate for each one automatically.
  "routes": [
    { "pattern": "maureenmuturi.com", "custom_domain": true },
    { "pattern": "www.maureenmuturi.com", "custom_domain": true }
  ],
  "assets": {
    // The folder `npm run build` fills.
    "directory": "./dist",
    // Any address that doesn't match a file gets dist/404.html, with a real 404 status.
    "not_found_handling": "404-page"
  }
}
