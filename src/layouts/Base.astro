---
// Every page wraps itself in this layout:
//   <Base title="…" description="…"> page content </Base>
// It supplies the <head>, header, footer and scripts, so pages hold only their own content.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;   // true = ask search engines not to list this page (the 404)
}
const { title, description, noindex = false } = Astro.props;

// Full address of this page, e.g. https://maureenmuturi.com/about/
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{title}</title>
  <meta name="description" content={description}>

  {noindex
    ? <meta name="robots" content="noindex">
    : <link rel="canonical" href={url}>}

  <!-- How the page looks when someone pastes the link into Slack, WhatsApp,
       LinkedIn or X. Without these you get a bare grey box. -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Maureen Muturi">
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Websites that load fast and work everywhere — Maureen Muturi, front-end developer">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1f2937" media="(prefers-color-scheme: dark)">

  <!-- is:inline = Astro leaves this script exactly where it is instead of
       bundling it. It has to run before the page paints, so there's no
       flash of the wrong theme. Also marks the page as JavaScript-capable. -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      root.classList.add('js');
      var choice;
      try { choice = localStorage.getItem('theme'); } catch (e) { /* private mode */ }
      if (choice !== 'light' && choice !== 'dark') {
        choice = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      root.setAttribute('data-theme', choice);
    })();
  </script>
</head>
<body class="flex min-h-screen flex-col bg-white font-sans text-gray-900 antialiased transition-colors duration-300 dark:bg-gray-800 dark:text-gray-100">

  <!-- Off-screen until a keyboard user presses Tab, then it appears. -->
  <a href="#main" class="sr-only z-[60] rounded-full bg-blue-600 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
    Skip to content
  </a>

  <Header />

  <!-- flex-1 lets main take up any spare height, so the footer sits at the
       bottom of the window even on a short page. -->
  <main id="main" class="flex-1">
    <slot />
  </main>

  <Footer />

  <!-- Astro processes this and runs it after the HTML has loaded — the same
       job `defer` did before. It's small, so Astro writes it straight into
       each page rather than making the browser fetch a separate file. -->
  <script src="../scripts/main.js"></script>
</body>
</html>
