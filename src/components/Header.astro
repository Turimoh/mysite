---
// The part between the --- fences runs at build time, not in the visitor's browser.
// It works out which page we're on, so the right nav link gets aria-current.
const links = [
  { href: '/',         label: 'Home' },
  { href: '/about/',   label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-gray-100/80 shadow-lg backdrop-blur-md transition-colors duration-300 dark:border-gray-800 dark:bg-gray-700/80">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="text-xl font-bold tracking-tight text-gray-900 transition-colors hover:text-blue-600 dark:text-white dark:hover:text-blue-400">
      Maureen Muturi
    </a>

    <div class="flex items-center gap-6">
      <nav aria-label="Main">
        <ul class="flex gap-6 text-sm font-medium">
          {links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={here === href ? 'page' : undefined}
                class="nav-underline text-gray-700 transition-colors hover:text-blue-600 aria-[current=page]:text-blue-600 dark:text-gray-200 dark:hover:text-blue-400 dark:aria-[current=page]:text-blue-400"
              >{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <button
        class="theme-toggle size-9 cursor-pointer items-center justify-center rounded-full bg-white text-gray-600 shadow-sm transition-transform duration-300 hover:-rotate-12 hover:text-blue-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:text-blue-400"
        type="button" data-theme-toggle aria-label="Switch theme"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none"
             stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"/>
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/>
        </svg>
      </button>
    </div>
  </div>
</header>
