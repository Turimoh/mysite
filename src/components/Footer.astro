---
const links = [
  { href: 'mailto:maureenmuturi44@gmail.com',            label: 'Email' },
  { href: 'https://www.linkedin.com/in/maureen-muturi/', label: 'LinkedIn' },
  { href: 'https://github.com/turimoh',                  label: 'GitHub' },
];
---

<footer class="border-t border-gray-200 bg-gray-100 text-sm text-gray-600 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400">
  <div class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-8 gap-y-4 px-6 py-8">
    <p>&copy; {new Date().getFullYear()} Maureen Wanja Muturi</p>
    <ul class="flex flex-wrap gap-4">
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class="transition-colors hover:text-green-600 dark:hover:text-green-400">{label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
